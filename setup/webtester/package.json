{
  "name": "webtester",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "prepare:data": "node scripts/prepare-historical-data.mjs",
    "dev": "npm run prepare:data && astro dev",
    "build": "npm run prepare:data && astro build",
    "preview": "astro preview",
    "check": "npm run prepare:data && astro check",
    "test": "node --experimental-strip-types --test test/historical-evidence.test.mjs",
    "test:smoke": "node scripts/smoke-test-preview.mjs",
    "test:browser": "node test/browser-acceptance.test.mjs",
    "format": "prettier --write .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.4.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.16.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "tw-animate-css": "^1.4.0"
  }
}
