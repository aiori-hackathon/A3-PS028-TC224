---
interface Props {
  code: string;
  language?: string;
}

const { code, language = "bash" } = Astro.props;
---

<div class="code-block-wrapper relative rounded-lg border border-border/70 bg-black/5 dark:bg-black/30 overflow-hidden shadow-xs my-3">
  <div class="flex items-center justify-between px-3.5 py-1.5 border-b border-border/40 bg-muted/60 text-xs text-black font-mono">
    <span class="font-semibold text-foreground/80">{language}</span>
    <button
      type="button"
      class="copy-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-sans font-medium border border-border/60 bg-card hover:bg-muted/80 text-black transition-colors cursor-pointer"
      data-code={code}
      title="Copy to clipboard"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-3.5 copy-icon text-black"
        aria-hidden="true"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-3.5 check-icon text-emerald-600 hidden"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <span class="copy-label text-black">Copy</span>
    </button>
  </div>
  <pre class="p-4 text-xs sm:text-sm font-mono text-black overflow-x-auto leading-relaxed select-all whitespace-pre"><code>{code}</code></pre>
</div>
