---
import {
  Card,
  CardHeader,
  CardTitle,
  CardContent,
  CardFooter,
} from "@/components/ui/card";
import { ArrowRightIcon } from "lucide-react";
import { cn } from "@/lib/utils.ts";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  title: string;
  actionText?: string;
  disabled?: boolean;
};

const {
  title,
  href,
  actionText = "Run test",
  disabled = false,
  ...attributes
} = Astro.props;
---

<a
  href={disabled ? undefined : href}
  class={cn("group", disabled ? "cursor-not-allowed" : "cursor-pointer")}
  {...attributes}
>
  <Card
    className={cn(
      "transition-all duration-200 hover:border-primary",
      disabled && "pointer-events-none opacity-50",
    )}
  >
    <CardHeader>
      <CardTitle>
        {title}
      </CardTitle>
    </CardHeader>

    <CardContent>
      <p class="text-sm text-muted-foreground">
        <slot />
      </p>
    </CardContent>

    {
      !disabled && (
        <CardFooter>
          <div class="flex items-center gap-2 text-sm font-medium transition-colors duration-200 underline-offset-4 group-hover:underline">
            {actionText}
            <ArrowRightIcon className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" />
          </div>
        </CardFooter>
      )
    }
  </Card>
</a>
